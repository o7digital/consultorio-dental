---
import { contact, labels, routes, type Language, type PageKind } from '../data/site';

interface Props {
  lang: Language;
  page: PageKind;
}

const { lang, page } = Astro.props;
const text = labels[lang];
---
<footer>
  <div class="footer-brand"><a class="brand" href={routes.home[lang]} aria-label={`${contact.brand} — ${text.home}`}><img class="brand-logo" src="/assets/logo-dental-satelite-white.svg" width="700" height="254" alt="Dental Satélite" loading="lazy" decoding="async" /></a></div>
  {page === 'home' ? (
    <>
      <div><small>{text.visit}</small><address>{contact.street}<br />{contact.locality}</address></div>
      <div>
        <small>{text.footerContact}</small>
        <ul class="footer-contact-list">
          <li>
            <a class="footer-contact-link" href={contact.phoneHref} aria-label={`${text.phone}: ${contact.phone}`}>
              <span class="footer-contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="m7 3 3 5-2.2 2.2a15 15 0 0 0 6 6L16 14l5 3v3a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1Z" /></svg>
              </span>
              <span>{contact.phone}</span>
            </a>
          </li>
          <li>
            <a class="footer-contact-link" href={contact.whatsappHref} target="_blank" rel="noopener" aria-label={`${text.whatsapp}: ${contact.whatsapp}`}>
              <span class="footer-contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M21 11.5a9 9 0 0 1-13.4 7.9L3 21l1.5-4.7A9 9 0 1 1 21 11.5Z" /><path d="m8.2 7.4 1.5 2.4-1.1 1.1a8.2 8.2 0 0 0 3.9 3.8l1.1-1.1 2.4 1.5c-.2 1.1-.9 1.7-2 1.7-3.7-.5-7-3.8-7.5-7.5 0-1.1.6-1.8 1.7-1.9Z" /></svg>
              </span>
              <span>WhatsApp: {contact.whatsapp}</span>
            </a>
          </li>
          <li>
            <a class="footer-contact-link" href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label={text.instagram}>
              <span class="footer-contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.6" r=".8" fill="currentColor" stroke="none" /></svg>
              </span>
              <span>Instagram</span>
            </a>
          </li>
        </ul>
      </div>
    </>
  ) : (
    <>
      <div><a href={`${routes.home[lang]}#contacto`}>{text.contact}</a></div>
      <div><a href={routes.home[lang]}>{text.backToHome}</a></div>
    </>
  )}
  <div class="footer-bottom">
    <span>© 2026 {contact.brand}</span>
    <a class="footer-privacy-link" href={routes.privacy[lang]} aria-current={page === 'privacy' ? 'page' : undefined}>{text.privacy}</a>
    <span class="site-credit">{text.siteCredit} <a href="https://www.o7digital.com/es/index-digital-agency" target="_blank" rel="noopener noreferrer">o7digital</a></span>
  </div>
</footer>

<style>
  .footer-contact-list {
    display: grid;
    gap: 4px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }

  .footer-contact-link {
    display: flex;
    align-items: center;
    gap: 12px;
    width: fit-content;
    min-height: 40px;
    font-size: 14px;
    line-height: 1.5;
  }

  .footer-contact-icon {
    display: grid;
    place-items: center;
    flex: 0 0 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 50%;
    background: rgba(255, 255, 255, .06);
    color: var(--accent);
  }

  .footer-contact-link:hover .footer-contact-icon {
    background: rgba(255, 255, 255, .16);
    color: var(--white);
  }

  .footer-contact-link:focus-visible {
    outline-color: var(--accent);
  }

  .footer-bottom {
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-right: 64px;
    font-size: 12px;
    line-height: 1.6;
  }

  .footer-privacy-link {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-credit a {
    color: var(--white);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    white-space: nowrap;
  }

  .site-credit a:focus-visible {
    outline-color: var(--accent);
  }

  @media (max-width: 560px) {
    .footer-bottom {
      align-items: flex-start;
    }
  }
</style>
