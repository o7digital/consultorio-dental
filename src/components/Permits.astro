---
import type { Language } from '../data/site';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const copy = {
  es: {
    eyebrow: 'Documentación del consultorio',
    heading: 'Permisos y registro profesional.',
    intro: 'Consulta los documentos del consultorio. Selecciona una fotografía para verla en grande.',
    municipal: 'Licencia municipal',
    licenseTitle: 'Licencia de funcionamiento',
    licenseAlt: 'Fotografía de la licencia de funcionamiento de Consultorio Dental Satélite, expediente 00019957, a nombre de Lourdes Carrillo Rojas',
    licenseOpen: 'Ampliar la fotografía de la licencia de funcionamiento',
    reference: 'No. de expediente',
    issued: 'Emisión',
    startDate: '12 de febrero de 2025',
    validity: 'Vigencia indicada',
    endDate: '31 de diciembre de 2027',
    professional: 'Registro profesional',
    credentialTitle: 'Cédula profesional',
    credentialAlt: 'Imagen de la cédula profesional 1624170 de Lourdes Carrillo Rojas, Licenciatura como Cirujano Dentista de la Universidad Nacional Autónoma de México',
    credentialOpen: 'Ampliar la imagen de la cédula profesional de Lourdes Carrillo Rojas',
    credentialReference: 'Número de cédula',
    credentialIssued: 'Expedición electrónica',
    credentialDate: '18 de diciembre de 2022',
    enlarge: 'Ver documento en grande',
  },
  en: {
    eyebrow: 'Practice documentation',
    heading: 'Operating license and professional registration.',
    intro: 'View the practice’s documents. Select a photograph to see it at full size.',
    municipal: 'Municipal license',
    licenseTitle: 'Operating license',
    licenseAlt: 'Photograph of the operating license for Consultorio Dental Satélite, file 00019957, held by Lourdes Carrillo Rojas',
    licenseOpen: 'Enlarge the photograph of the operating license',
    reference: 'File number',
    issued: 'Issued',
    startDate: 'February 12, 2025',
    validity: 'Stated validity',
    endDate: 'December 31, 2027',
    professional: 'Professional registration',
    credentialTitle: 'Professional license',
    credentialAlt: 'Image of professional license 1624170 for Lourdes Carrillo Rojas, degree in dental surgery from Universidad Nacional Autónoma de México',
    credentialOpen: 'Enlarge the image of Lourdes Carrillo Rojas’s professional license',
    credentialReference: 'License number',
    credentialIssued: 'Electronic issue date',
    credentialDate: 'December 18, 2022',
    enlarge: 'View full-size document',
  },
}[lang];

const imageSizes = '(max-width: 560px) 96px, 132px';
---
<section class="permits-section" id="permisos" aria-labelledby="permits-title">
  <div class="permits-heading">
    <div><p class="eyebrow"><span></span>{copy.eyebrow}</p><h2 id="permits-title">{copy.heading}</h2></div>
    <p>{copy.intro}</p>
  </div>
  <div class="permits-grid">
    <figure class="permit-card">
      <a class="permit-photo" href="/assets/permits/licencia-funcionamiento.jpg" target="_blank" rel="noopener" aria-label={copy.licenseOpen}>
        <img src="/assets/permits/licencia-funcionamiento-1280.webp" srcset="/assets/permits/licencia-funcionamiento-640.webp 640w, /assets/permits/licencia-funcionamiento-1280.webp 1280w" sizes={imageSizes} width="2550" height="3300" alt={copy.licenseAlt} loading="lazy" decoding="async" />
      </a>
      <figcaption>
        <p class="permit-type">{copy.municipal}</p>
        <h3>{copy.licenseTitle}</h3>
        <p>{copy.reference}: <strong class="permit-reference">00019957</strong> · Lourdes Carrillo Rojas</p>
        <p class="permit-dates">{copy.issued}: <time datetime="2025-02-12">{copy.startDate}</time><br />{copy.validity}: <time datetime="2027-12-31">{copy.endDate}</time></p>
        <a class="permit-open" href="/assets/permits/licencia-funcionamiento.jpg" target="_blank" rel="noopener">{copy.enlarge}<span aria-hidden="true">↗</span></a>
      </figcaption>
    </figure>
    <figure class="permit-card">
      <a class="permit-photo" href="/assets/permits/cedula-lourdes-carrillo.jpg" target="_blank" rel="noopener" aria-label={copy.credentialOpen}>
        <img src="/assets/permits/cedula-lourdes-carrillo-1280.webp" srcset="/assets/permits/cedula-lourdes-carrillo-640.webp 640w, /assets/permits/cedula-lourdes-carrillo-1280.webp 1280w" sizes={imageSizes} width="2344" height="3064" alt={copy.credentialAlt} loading="lazy" decoding="async" />
      </a>
      <figcaption>
        <p class="permit-type">{copy.professional}</p>
        <h3>{copy.credentialTitle}</h3>
        <p>{copy.credentialReference}: <strong class="permit-reference">1624170</strong> · Lourdes Carrillo Rojas</p>
        <p>Universidad Nacional Autónoma de México</p>
        <p class="permit-dates">{copy.credentialIssued}: <time datetime="2022-12-18">{copy.credentialDate}</time></p>
        <a class="permit-open" href="/assets/permits/cedula-lourdes-carrillo.jpg" target="_blank" rel="noopener">{copy.enlarge}<span aria-hidden="true">↗</span></a>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .permits-section{padding:48px max(22px,calc((100vw - 1080px)/2));background:var(--cream);scroll-margin-top:24px}
  .permits-heading{margin-bottom:24px}
  .permits-heading .eyebrow{font-size:10px;margin-bottom:14px}
  .permits-heading h2{font:500 28px/1.2 Manrope,sans-serif;letter-spacing:-.035em;margin-bottom:12px}
  .permits-heading>p{font-size:14px;line-height:1.6;color:var(--muted);margin-bottom:0}
  .permits-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start}
  .permit-card{display:grid;grid-template-columns:132px minmax(0,1fr);gap:20px;margin:0;padding:20px;background:var(--white);border:1px solid var(--line);min-width:0}
  .permit-photo{display:block;width:132px;height:176px;padding:6px;background:var(--white);border:1px solid var(--line);cursor:zoom-in}
  .permit-photo img{width:100%;height:100%;object-fit:contain}
  figcaption{min-width:0}
  .permit-type{font:600 10px/1.5 Manrope,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
  h3{font:500 18px/1.3 Manrope,sans-serif;letter-spacing:-.025em;margin-bottom:10px}
  figcaption>p:not(.permit-type){font-size:12px;line-height:1.6;margin-bottom:8px}
  figcaption>.permit-dates{color:var(--muted)}
  .permit-reference{white-space:nowrap}
  .permit-open{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:44px;margin-top:12px;padding-top:8px;border-top:1px solid var(--line);font-size:12px;font-weight:600;line-height:1.5}
  .permit-open span{flex:none}
  @media(max-width:1000px){.permits-grid{grid-template-columns:1fr}.permit-card{width:100%;max-width:600px}}
  @media(max-width:560px){.permit-card{grid-template-columns:96px minmax(0,1fr);gap:14px;padding:14px}.permit-photo{width:96px;height:128px}.permits-heading h2{font-size:24px}}
</style>
