  <meta property="og:image:width" content="1691">
  <meta property="og:image:height" content="930">
  <meta property="og:image:alt" content="Smiling patient at Consultorio Dental Satélite">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Dentist in Ciudad Satélite | Consultorio Dental Satélite">
