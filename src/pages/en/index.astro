---
import AppointmentForm from "../../components/AppointmentForm.astro";
import Team from "../../components/Team.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout lang="en" title={"Dentist in Ciudad Satélite | Consultorio Dental Satélite"} description={"Dentist in Ciudad Satélite, Naucalpan. Personalized preventive, cosmetic and restorative dentistry, dental implants and orthodontics."}>
  <Fragment slot="head">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Consultorio Dental Satélite">
  <meta property="og:title" content="Dentist in Ciudad Satélite | Consultorio Dental Satélite">
  <meta property="og:description" content="Comprehensive dentistry in Ciudad Satélite, Naucalpan. Dental implants, prosthetics, cosmetic dentistry and personalized care.">
  <meta property="og:url" content="https://consultoriodentalsatelite.com.mx/en/">
  <meta property="og:image" content="https://consultoriodentalsatelite.com.mx/assets/hero.webp">
  <meta property="og:image:width" content="1691">
  <meta property="og:image:height" content="930">
  <meta property="og:image:alt" content="Smiling patient at Consultorio Dental Satélite">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Dentist in Ciudad Satélite | Consultorio Dental Satélite">
  <meta name="twitter:description" content="Comprehensive, personalized dental care in Ciudad Satélite, Naucalpan.">
  <meta name="twitter:image" content="https://consultoriodentalsatelite.com.mx/assets/hero.webp">
  <link rel="preload" href="/assets/hero.webp" as="image" type="image/webp" imagesrcset="/assets/hero-900.webp 900w, /assets/hero.webp 1691w" imagesizes="(max-width: 900px) calc(100vw - 44px), 49vw" fetchpriority="high">
  <script is:inline>document.documentElement.classList.add('js')</script>
  <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Dentist",
      "@id": "https://consultoriodentalsatelite.com.mx/#dentist",
      "name": "Consultorio Dental Satélite",
      "url": "https://consultoriodentalsatelite.com.mx/en/",
      "image": "https://consultoriodentalsatelite.com.mx/assets/hero.webp",
      "telephone": "+52 55 5393 8629",
      "description": "Comprehensive dental care in Ciudad Satélite: prevention, diagnosis, cosmetic dentistry, implants, orthodontics, root canal treatment and prosthetics.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Circuito Historiadores S 44, Local 3",
        "addressLocality": "Ciudad Satélite",
        "addressRegion": "Estado de México",
        "postalCode": "53100",
        "addressCountry": "MX"
      },
      "areaServed": ["Ciudad Satélite", "Naucalpan de Juárez"],
      "sameAs": [
        "https://www.instagram.com/consultorio_dental_satelite/"
      ]
    }
  </script>
  </Fragment>
  <main>
    <section class="hero" id="inicio">
      <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> Comprehensive dentistry · Ciudad Satélite</p>
        <h1>Expert care for your oral health.<br><em>We care for your smile.</em></h1>
        <p class="lead">Preventive, cosmetic and restorative dentistry in one place. A team that listens and supports you with a personalized care plan.</p>
        <div class="actions">
          <a class="button button-primary" href="#contacto" data-appointment-link>Book an appointment <span>→</span></a>
          <a class="text-link" href="#servicios">Explore our treatments <span>↓</span></a>
        </div>
        <div class="trust-row">
          <div class="avatars"><b>D</b><b>C</b><b>S</b></div>
          <p><strong>Specialized care</strong><br>for every stage of your smile</p>
        </div>
      </div>
      <div class="hero-visual reveal delay">
        <div class="image-frame">
          <img src="/assets/hero.webp" srcset="/assets/hero-900.webp 900w, /assets/hero.webp 1691w" sizes="(max-width: 900px) calc(100vw - 44px), 49vw" width="1691" height="930" alt="Smiling patient at Consultorio Dental Satélite" decoding="async" fetchpriority="high">
          <div class="image-caption"><span>01</span><p>Clear diagnosis.<br>Precise treatment.</p></div>
        </div>
        <div class="floating-card">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21c4.6-3.1 7-7.2 7-12.1C19 5.1 16.9 3 14.2 3c-1 0-1.7.4-2.2 1-.5-.6-1.2-1-2.2-1C7.1 3 5 5.1 5 8.9 5 13.8 7.4 17.9 12 21Z"/></svg>
          <div><strong>Your well-being comes first</strong><small>A plan designed for you</small></div>
        </div>
      </div>
    </section>

    <section class="promise">
      <p>DENTISTRY WITH PURPOSE</p>
      <h2>We love to see you smile.<br>It is part of <em>who you are.</em></h2>
      <div class="promise-grid">
        <p>We bring different areas of dentistry together to support you at every stage of treatment. We begin with a clinical assessment and explain your options based on your needs.</p>
        <a href="#nosotros">Our approach <span>→</span></a>
      </div>
    </section>

    <section class="services" id="servicios">
      <div class="section-head">
        <div><p class="eyebrow"><span></span> Treatments</p><h2>Solutions to help you smile<br>with confidence.</h2></div>
        <p>From prevention to full-mouth rehabilitation, we develop a clear, personalized plan for you.</p>
      </div>
      <div class="service-grid">
        <article class="service-card featured">
          <div class="service-num">01</div><h3>Smile design</h3><p>The shape, colour and position of your teeth all contribute to your smile. We assess them together to suggest changes that suit your expression and oral health.</p>
          <details><summary>What we can improve</summary><p>We examine your teeth, gums and bite and listen to what you would like to change. Depending on your needs, your plan may combine whitening, orthodontics, restorations, veneers or implants.</p><p>Before treatment, we explain the alternatives, the order of each step and the care involved. This helps you make an informed choice with goals suited to your individual case.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Discuss your smile — appointment form">Discuss your smile <span>↗</span></a>
        </article>
        <article class="service-card">
          <div class="service-num">02</div><h3>Dental implants</h3><p>If one or more teeth are missing, an implant may be a restorative option. A consultation helps you understand the alternatives for eating, speaking and smiling with confidence.</p>
          <details><summary>How an implant is planned</summary><p>A titanium implant is placed in the jawbone to support a crown or prosthetic restoration. It can replace a missing tooth without using neighbouring teeth as supports.</p><p>We assess your gums, available bone and any studies your case requires. We explain the stages of treatment, follow-up and daily hygiene needed to care for the restoration.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Discuss an implant — appointment form">Discuss an implant <span>↗</span></a>
        </article>
        <article class="service-card">
          <div class="service-num">03</div><h3>Prevention and diagnosis</h3><p>A check-up helps you understand the health of your teeth and gums, even when nothing hurts. Identifying changes and improving daily care helps guide timely dental attention.</p>
          <details><summary>What your visit includes</summary><p>We examine your teeth, gums, bite, jaw joint and oral tissues. Where needed, photographs or additional studies support the assessment so we can explain the findings and your options.</p><p>You receive guidance on brushing and flossing and, depending on your needs, fluoride or sealants. The timing of check-ups and preventive care is tailored to your oral health.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Book your check-up — appointment form">Book your check-up <span>↗</span></a>
        </article>
        <article class="service-card">
          <div class="service-num">04</div><h3>Oral surgery</h3><p>Wisdom teeth and other dental concerns may require surgical care. We assess your situation to explain when a procedure may be needed and how to prepare for it.</p>
          <details><summary>Assessment and aftercare</summary><p>An assessment and any appropriate studies help us examine the position of your teeth and nearby tissues. This information guides the decision about whether an extraction or another procedure is needed.</p><p>Depending on your case, we provide wisdom tooth extractions, implant placement, bone preservation or augmentation and gum procedures. We explain preparation, aftercare and follow-up.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Discuss your case — appointment form">Discuss your case <span>↗</span></a>
        </article>
        <article class="service-card">
          <div class="service-num">05</div><h3>Orthodontics</h3><p>Orthodontics assesses the position of your teeth and how they meet when you bite. Your treatment is chosen around your needs, daily habits and the goals for your smile.</p>
          <details><summary>Braces and clear aligners</summary><p>We offer braces and Invisalign clear aligners. An assessment of your teeth and bite helps us identify suitable options and explain the differences between them.</p><p>Your plan includes appointments to review tooth movement and guidance on hygiene during treatment. We also explain how following instructions and using retainers after treatment help maintain the position of your teeth.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Explore your options — appointment form">Explore your options <span>↗</span></a>
        </article>
        <article class="service-card">
          <div class="service-num">06</div><h3>Root canal treatment</h3><p>When the inside of a tooth is infected, root canal treatment may help preserve it. We first assess the cause of your symptoms and whether this treatment is suitable for your tooth.</p>
          <details><summary>How the inside of a tooth is treated</summary><p>Treatment involves removing infected tissue, cleaning the root canals and sealing them. The aim is to address the infection and help preserve your natural tooth.</p><p>Your assessment allows us to explain the steps and appointments that may be needed. After treatment, we review the restoration required to protect the tooth and restore its function, along with recommended follow-up.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Have your tooth assessed — appointment form">Have your tooth assessed <span>↗</span></a>
        </article>
        <article class="service-card">
          <div class="service-num">07</div><h3>Dental prosthetics</h3><p>Missing or worn teeth can affect how you eat, speak and smile. Dental prosthetics aim to restore those functions with a solution tailored to your mouth.</p>
          <details><summary>Restoration tailored to you</summary><p>We assess your remaining teeth, gums and bite to consider how to replace missing teeth or restore damaged ones. The choice of prosthetic restoration depends on each person’s needs and oral health.</p><p>We explain the adjustment period, cleaning and daily care involved. Check-ups allow us to assess the fit and support you as you get used to the restoration.</p></details>
          <a href="#contacto" data-appointment-link aria-label="Discuss a restoration — appointment form">Discuss a restoration <span>↗</span></a>
        </article>
      </div>
    </section>

    <section class="about" id="nosotros">
      <div class="about-image reveal"><img src="/assets/team.webp" srcset="/assets/team-800.webp 800w, /assets/team.webp 1600w" sizes="(max-width: 900px) 100vw, 50vw" width="1600" height="1200" alt="The Consultorio Dental Satélite team at the practice" loading="lazy" decoding="async"><span>You are in caring hands.</span></div>
      <div class="about-copy reveal delay">
        <p class="eyebrow light"><span></span> What defines us</p>
        <h2>Dental care.<br><em>A personal approach.</em></h2>
        <p>Meet the people supporting you at our practice: dental care professionals, reception and support staff who look after every detail of your visit with a personal approach.</p>
        <div class="stats"><div><strong>Comprehensive</strong><span>Different areas of dentistry in one place</span></div><div><strong>Personalized</strong><span>Plans tailored to your needs</span></div></div>
        <a class="button button-light" href="#equipo">Meet the team <span>→</span></a>
      </div>
    </section>

    <Team lang="en" />
    <section class="technology" id="tecnologia">
      <div class="section-head"><div><p class="eyebrow"><span></span> Technology</p><h2>Tools for<br>precise care.</h2></div><p>Digital tools that help us assess your case and plan your treatment.</p></div>
      <div class="digital-grid">
        <article class="technology-copy"><span>01 · Digital imaging</span><h3>Digital X-rays</h3><p>Our digital X-ray system captures images of your teeth and displays them directly on a computer to support the clinical assessment.</p></article>
        <article class="technology-copy"><span>02 · Digital models</span><h3>Intraoral scanner</h3><p>We create digital models of your mouth to share with the dental laboratory and support treatments that require them.</p></article>
      </div>
    </section>
    <section class="about clinic-section" id="consultorio">
      <div class="about-image"><picture><source media="(max-width: 560px)" srcset="/assets/reception-mobile.webp"><img src="/assets/reception-1440.webp" width="1440" height="1080" alt="Consultorio Dental Satélite reception, with a blue wall and welcome desk" loading="lazy" decoding="async"></picture></div>
      <div class="about-copy"><p class="eyebrow light"><span></span> Our practice</p><h2>A place to<br><em>feel at ease.</em></h2><p>We welcome you to our Ciudad Satélite practice, where we listen to your needs and support you throughout your dental care.</p><a class="button button-light" href="#contacto">Plan your visit <span>↓</span></a></div>
    </section>

    <section class="experience" id="experiencia">
      <p class="eyebrow"><span></span> Your experience</p>
      <div class="quote-mark">“</div>
      <blockquote>We want you to feel heard,<br>comfortable and in caring hands.</blockquote>
      <div class="steps">
        <div><b>01</b><h3>We listen</h3><p>We learn about your needs, questions and goals.</p></div>
        <div><b>02</b><h3>We assess</h3><p>A thorough assessment supported by modern technology.</p></div>
        <div><b>03</b><h3>We plan</h3><p>A clear treatment plan tailored to you.</p></div>
        <div><b>04</b><h3>We support</h3><p>Personal follow-up before, during and after treatment.</p></div>
      </div>
    </section>

    <section class="contact-section" id="contacto">
      <div class="section-head"><div><p class="eyebrow"><span></span> Your next visit</p><h2>Book an appointment.</h2></div><p>Fill in your contact details and preferences. Our team will contact you to confirm availability.</p></div>
      <AppointmentForm lang="en" />
      <iframe class="contact-map" title="Consultorio Dental Satélite location on Google Maps" src="https://www.google.com/maps?q=Consultorio%20Dental%20Sat%C3%A9lite%20Circuito%20Historiadores%20S%2044%20Naucalpan&amp;output=embed" width="1200" height="420" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </section>

    <section class="cta-section">
      <div><p class="eyebrow light"><span></span> Take the first step</p><h2>Your new smile<br>starts here.</h2></div>
      <div><p>Book a consultation to explore the right treatment for you.</p><a class="button button-white" href="#contacto" data-appointment-link>Book an appointment <span>→</span></a></div>
    </section>
  </main>

  <script>
    import "../../scripts/site.js";
  </script>
</SiteLayout>
